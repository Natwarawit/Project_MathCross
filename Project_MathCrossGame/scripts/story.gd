# ===============================
# STORY DATABASE (ตัวควบคุมทั้งหมด)
# ===============================
var STORY_DB = {}

# Runtime
var current_story : Array = []
var current_bg_map : Dictionary = {}
var next_scene_path := ""
var current_index := 0

# ===============================
# READY
# ===============================
func _ready():
	# ใช้ Background2 ตั้งแต่ shop เป็นต้นไป
	if story_id != "intro":
		use_bg2 = true
		
	background.visible = !use_bg2 
	background2.visible = use_bg2

	# ถ้าเข้ามาจากด่าน ให้ override story อัตโนมัติ
	match global.last_cleared_stage:
		0: story_id = "shop"
		1: story_id = "stage1"
		2: story_id = "stage2"
		3: story_id = "stage3"
		4: story_id = "stage4"
		5: story_id = "stage5"
		6: story_id = "stage6"
		7: story_id = "boss"

	if story_id != "intro":
		use_bg2 = true
		
	background.visible = !use_bg2 
	background2.visible = use_bg2
	
	# สร้าง Database
	STORY_DB = {

		"intro": {
			"lines": intro_story,
			"bg_map": {
				0: bg_intro,
				1: bg_intro2,
				2: bg_intro3,
				3: bg_intro4,
				4: bg_intro5,
				6: bg_intro6,
				7: bg_intro8,
				10: bg_intro9,
				16: bg_intro10,
				17: bg_intro9,
				18: bg_intro11,
				21: bg_intro12,
				24: bg_intro9,
				29: bg_intro13,
				30: bg_intro14,
				31: bg_intro15
			},
			"next_scene": "res://scenes/world.tscn"
		},

		"shop": {
			"lines": shop_story,
			"bg_map": {
				0: bg_shop9,
				3: bg_shop,
				7: bg_shop11,
				8: bg_shop12,
				11: bg_shop10,
				12:bg_shop2,
				17:bg_shop4,
				19: bg_shop,
			},
			"next_scene": "res://scenes/rest.tscn"
		},

		"stage1": {"lines": stage1_clear,"bg_map": {0: bg_shop,1:bg_shop4,4:bg_shop7,6:bg_shop,7:bg_shop4},"next_scene": "res://scenes/rest.tscn"}, 
		"stage2": {"lines": stage2_clear,"bg_map": {0: bg_shop,1:bg_shop4,3:bg_shop6,5:bg_shop7},"next_scene": "res://scenes/rest.tscn"}, 
		"stage3": {"lines": stage3_clear,"bg_map": {0: bg_shop,2:bg_shop2,3:bg_shop6,5:bg_shop7,6:bg_shop5},"next_scene": "res://scenes/rest.tscn"}, 
		"stage4": {"lines": stage4_clear,"bg_map": {0: bg_shop6,3:bg_shop2,4:bg_shop5},"next_scene": "res://scenes/rest.tscn"}, 
		"stage5": {"lines": stage5_clear,"bg_map": {0: bg_shop4,2:bg_shop5},"next_scene": "res://scenes/rest.tscn"}, 
		"stage6": {"lines": stage6_clear,"bg_map": {0: bg_shop4, 2:bg_shop5, 5:bg_shop2},"next_scene": "res://scenes/rest.tscn"},

		"boss": {
			"lines": boss_intro,
			"bg_map": {0: bg_shop},
			"next_scene": "res://scenes/ending.tscn"
		},

		"ending": {
			"lines": ending_story,
			"bg_map": {0: bg_shop},
			"next_scene": "res://scenes/title.tscn"
		}
	}

	load_story()
	show_next_message()

# ===============================
# โหลด Story
# ===============================
func load_story():

	var data = STORY_DB.get(story_id)

	if data == null:
		push_error("Story not found")
		return

	current_story = data["lines"]
	current_bg_map = data["bg_map"]
	next_scene_path = data["next_scene"]
	current_index = 0

# ===============================
# Click → Next Message
# ===============================
func _input(event):
	if event is InputEventMouseButton and event.pressed:
		show_next_message()

# ===============================
# เปลี่ยน Background ตาม Timeline
# ===============================
func update_background():
	if current_bg_map.has(current_index):
		if use_bg2:
			background2.texture = current_bg_map[current_index]
		else:
			background.texture = current_bg_map[current_index]

# ===============================
# แสดงข้อความ
# ===============================
func show_next_message():

	if current_index >= current_story.size():
		_on_next_scene_pressed()
		return

	update_background()
	storylabel.text = current_story[current_index]
	current_index += 1

# ===============================
# ไปฉากถัดไป
# ===============================
func _on_next_scene_pressed():
	if next_scene_path == "":
		return

	var loading_scene = loading.instantiate()
	loading_scene.next_scene = next_scene_path
	add_child(loading_scene)
